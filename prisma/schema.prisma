generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  CLOSED
  CORRECTED
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  ESSAY
}

enum SubmissionStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  CORRECTED
}

model Exam {
  id          String     @id @default(uuid())
  title       String
  description String?
  classroomId String
  teacherId   String
  status      ExamStatus @default(DRAFT)
  availableAt DateTime?
  deadlineAt  DateTime?
  timeLimit   Int?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  questions   Question[]
  submissions ExamSubmission[]

  @@index([classroomId])
  @@index([teacherId])
  @@index([status])
  @@index([availableAt])
  @@map("exams")
}

model Question {
  id            String       @id @default(uuid())
  examId        String
  statement     String
  type          QuestionType @default(MULTIPLE_CHOICE)
  options       Json?
  correctAnswer String?
  points        Decimal      @default(1.0) @db.Decimal(10, 2)
  position      Int
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  exam    Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@unique([examId, position])
  @@index([examId])
  @@map("questions")
}

model ExamSubmission {
  id          String           @id @default(uuid())
  examId      String
  studentId   String
  status      SubmissionStatus @default(NOT_STARTED)
  startedAt   DateTime?
  submittedAt DateTime?
  score       Decimal?         @db.Decimal(10, 2)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  exam    Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@unique([examId, studentId])
  @@index([studentId])
  @@index([status])
  @@map("exam_submissions")
}

model Answer {
  id             String   @id @default(uuid())
  submissionId   String
  questionId     String
  content        String?
  selectedOption String?
  isCorrect      Boolean?
  score          Decimal? @db.Decimal(10, 2)
  feedback       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  submission ExamSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question   Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, questionId])
  @@index([questionId])
  @@map("answers")
}
